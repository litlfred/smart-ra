  "@type": "archimate:ApplicationService",
  "schema:identifier": "id-3a48e3ef88f74e8d8c5e524df9f03e0c",
  "schema:name": "Consent Management Service",
  "schema:description": "This service manages the storage, retrieval, and enforcement of patient consent artifacts. It ensures that any request for health data is checked against the patient's current permission settings.&#xD;\n&#xD;\nThe purpose is to automate the enforcement of privacy policies and ensure that data is only shared according to the patient’s wishes. This provides a scalable way to manage complex privacy requirements across the network.&#xD;\n&#xD;\nExample: An API that returns \"Authorized\" or \"Denied\" when a doctor attempts to open a patient's surgical history.&#xD;",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.3.jsonld"
}
