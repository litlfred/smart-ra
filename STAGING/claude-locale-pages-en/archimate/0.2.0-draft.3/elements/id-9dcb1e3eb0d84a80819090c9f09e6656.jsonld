  "@id": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.3/elements/id-9dcb1e3eb0d84a80819090c9f09e6656.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-9dcb1e3eb0d84a80819090c9f09e6656",
  "schema:name": "Support interoperability across providers, facilities, and jurisdictions",
  "schema:description": "This sub-goal strives to eliminate data silos by adopting standardized protocols and terminologies for seamless health information exchange. It enables data to flow accurately between different healthcare facilities and across geographic boundaries.&#xD;\n&#xD;\nThe purpose is to reduce record fragmentation and improve care coordination by ensuring that patient data is readable and usable by any authorized system. It supports global mobility and effective public health surveillance through standardized data.&#xD;\n&#xD;\nExample: Standardizing all clinical data exchanges on the HL7 FHIR format across public and private hospitals.&#xD;",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.3.jsonld"
}
