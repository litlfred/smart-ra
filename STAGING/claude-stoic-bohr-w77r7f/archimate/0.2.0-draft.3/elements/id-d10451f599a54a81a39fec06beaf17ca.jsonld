  "@id": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.3/elements/id-d10451f599a54a81a39fec06beaf17ca.jsonld",
  "@type": "archimate:ApplicationService",
  "schema:identifier": "id-d10451f599a54a81a39fec06beaf17ca",
  "schema:name": "Client Identity Service",
  "schema:description": "This service provides the technical interface to identify, authenticate, and link individuals within the health system. It often bridges the gap between local health IDs and a national identity registry.&#xD;\n&#xD;\nThe purpose is to ensure that every clinical record is accurately associated with the correct physical person. This is foundational for patient safety and the creation of longitudinal medical histories.&#xD;\n&#xD;\nExample: A service that validates a patient’s fingerprint against the national ID database during hospital check-in.&#xD;",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.3.jsonld"
}
