  "@type": "archimate:Product",
  "schema:identifier": "id-3a0bab0cc8584ebcb8dc2fe149d1b63c",
  "schema:name": "Continuity of Care Bundle",
  "schema:description": "Continuity of Care Bundle:&#xD;\nA structured, interoperable digital package (e.g., FHIR-based) including discharge summary, medication list, pending results, and follow-up plan.&#xD;\nReduced readmission rates, duplicated tests and adverse events due to missed information.&#xD;\nImproved provider accountability across care episodes.&#xD;\nPatient-facing discharge/transition plan (simplified language, reminders).&#xD;\nPopulation-level monitoring of transition-of-care quality indicators (e.g., % timely discharge summaries sent, 30-day readmissions).",
  "schema:category": "Business",
  "dcterms:isPartOf": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.3.jsonld"
}
