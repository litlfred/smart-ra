  "schema:identifier": "id-b899407e0bcb45e4aad56439b02df862",
  "schema:name": "Analytics platform",
  "schema:description": "The analytics platform consists of the computational tools and software used to process raw health data into meaningful insights. It performs statistical analysis, pattern recognition, and data mining to support evidence-based decision-making.&#xD;\n&#xD;\nIts purpose is to identify cost-drivers and evaluate the efficiency of health programs through rigorous data analysis. It enables managers to move beyond simple reporting toward understanding the root causes of financial and clinical performance issues.&#xD;\n&#xD;\nExample: A software suite used to analyze which regions are experiencing the highest growth in pharmaceutical spending.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/folio-assistant/dpi-h-ra/archimate/0.2.0-draft.2.jsonld"
}
