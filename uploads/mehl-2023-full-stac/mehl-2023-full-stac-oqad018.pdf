         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A full-STAC remedy for global digital health transformation: open standards, technologies, architectures and content</rdf:li>
            </rdf:Alt>
         </dc:title>
