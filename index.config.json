        "input/indicators/",
        "input/maps/",
        "input/models/",
        "input/pagecontent/",
        "input/profiles/",
        "input/resources/",
        "input/scenarios/",
        "input/scheduling-logic/",
        "input/system-requirements/",
        "input/testing/",
        "input/vocabulary/",
        "fsh-generated/"
      ]
    }
