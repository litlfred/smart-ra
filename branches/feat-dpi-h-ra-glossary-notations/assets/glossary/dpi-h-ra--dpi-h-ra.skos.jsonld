    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Content"
        }
      ],
      "skos:altLabel": [
        "open content"
      ],
      "skos:definition": [
        {
          "@value": "Open content refers to domain ideas and synthesized knowledge clearly documented without restrictions inhibiting readability or usage."
        }
      ],
      "skos:scopeNote": "RA §2.2.2 body wording, verbatim (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-022-222-the-enabling-conditions-for-reddhi.md, p. 35–39), citing Mehl et al. 2023 (library/mehl-2023-full-stac-oqad018/, glossary/full-stac.glossary.json: \"Domain ideas and synthesized knowledge clearly documented without restrictions inhibiting readability or usage, such as health guidelines, workflows, core data elements, terminology mappings, and test cases aligned to standards.\"). Linked via exactMatch to the full-STAC scheme (smart-ra#133 S1, smart-ra#143).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/full-stac"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-standards"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-technologies"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures"
        }
      ],
      "skos:exactMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-content"
        }
      ],
      "dcterms:source": "library/who-dpi-h-reference-architecture-draft-v1/sections/sec-022-222-the-enabling-conditions-for-reddhi.md",
