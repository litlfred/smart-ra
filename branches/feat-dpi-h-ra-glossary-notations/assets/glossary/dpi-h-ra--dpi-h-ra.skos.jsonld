      ],
      "skos:notation": "CBMS",
      "skos:scopeNote": "Distinguished from the Benefits Package Registry (BPR) and Beneficiary Registry in the Appendix C comparison table as an operational financial-domain functional application managing payer-provider contracts, empanelment agreements, claims, and adjudication. A candidate: no standalone glossary definition has been written.",
      "dcterms:source": "folio/dpi-h-ra/appendix/t-c-business-services-components-benefits-package-registry-distinguishing-the-benefits-pack-c66f4f.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Management Information System"
        }
      ],
      "skos:altLabel": [
        "HMIS"
      ],
      "skos:definition": [
        {
          "@value": "The Health Management Information System is a governed, shared application component responsible for the systematic collection, aggregation, analysis, and dissemination of population-level and facility-level health data to support health system planning, performance monitoring, resource allocation, and policy decision-making."
        }
      ],
      "skos:notation": "HMIS",
      "skos:scopeNote": "Lead sentence from Appendix C (Health Management Information System, 1 What It Is). Abbreviated HMIS throughout the RA draft and downstream Digital Transformation Handbooks. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-business-services-components-health-management-information-sy-9dea8c.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/public-health-surveillance-platform",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Public Health Surveillance Platform"
        }
      ],
      "skos:altLabel": [
        "PHSP"
      ],
      "skos:definition": [
        {
          "@value": "The Public Health Surveillance Platform is a governed, shared application component for the systematic, ongoing collection, analysis, interpretation, and dissemination of health data to detect, monitor, and respond to public health threats and events."
        }
      ],
      "skos:notation": "PHSP",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Public Health Surveillance Platform, 1 What It Is). Abbreviated PHSP throughout the RA draft. A candidate until the RA editors adopt it through the public review.",
